# Grafana datasource provisioning template. @DB@ is substituted with the
# SQLite path at deploy time (see deploy/pi-grafana-setup.sh).
apiVersion: 1

datasources:
  - name: PiTelemetry
    uid: pitelemetry-sqlite
    type: frser-sqlite-datasource
    access: proxy
    isDefault: true
    jsonData:
      path: @DB@
    version: 1
    editable: true
